# =============================================================================
# Recetas Inteligentes — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# Documentación: ../docs/architecture.md
# =============================================================================

# -----------------------------------------------------------------------------
# Auth.js (NextAuth) — obligatorio en producción
# -----------------------------------------------------------------------------
# Secreto para firmar cookies y tokens. En producción es obligatorio.
# Generar: openssl rand -base64 32
AUTH_SECRET=

# URL pública de la aplicación (ej. http://localhost:3000 o https://tu-dominio.com)
AUTH_URL=

# Alias opcional (compatibilidad NextAuth)
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Base de datos (Azure SQL / Prisma) — obligatoria para persistencia de la app
# -----------------------------------------------------------------------------
# Sin DATABASE_URL no se guardan: historial, recetas, favoritos, recetarios,
# perfil en BD, sesiones de ingredientes, etc. La UI muestra avisos explícitos.
# Formato Prisma (SQL Server / Azure SQL) — no mezclar user:pass@host con ;database=...
# sqlserver://HOST:1433;database=DB_NAME;user=USER;password=PASS;encrypt=true;trustServerCertificate=false
# Azure SQL (login SQL): user=LOGIN@NOMBRE_SERVIDOR (ej. usuario@miservidor).
# Si la contraseña tiene : ; = { } etc., usa llaves: password={TuP@ss;word}
# Evita %XX en password aquí (puede provocar P1013); mejor llaves o comillas en el valor.
# Requerido también para `npx prisma generate` (puede ser placeholder local).
DATABASE_URL=

# -----------------------------------------------------------------------------
# OpenAI — obligatoria para generación de recetas y recomendaciones con modelo
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Opcional (por defecto gpt-4o-mini)
OPENAI_MODEL=

# Opcional: modelo con visión para fotos de ingredientes (por defecto = OPENAI_MODEL o gpt-4o-mini)
# OPENAI_VISION_MODEL=

# -----------------------------------------------------------------------------
# Azure Blob Storage — fotos de ingredientes (producción recomendada)
# -----------------------------------------------------------------------------
# Opción A (recomendada): cadena de conexión con AccountName + AccountKey
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
#
# Opción B: cuenta + clave + contenedor (el contenedor debe existir en la cuenta)
# AZURE_BLOB_STORAGE_ACCOUNT=
# AZURE_BLOB_STORAGE_ACCOUNT_KEY=
# Aliases admitidos: AZURE_STORAGE_ACCOUNT_NAME, AZURE_STORAGE_ACCOUNT_KEY
#
AZURE_BLOB_CONTAINER_NAME=

# Lectura pública sin token: si es "true", la URL guardada no lleva SAS (configura acceso anónimo de lectura a nivel blob en el contenedor).
# Si es "false" o está vacío, se añade un SAS de solo lectura (vida en AZURE_BLOB_SAS_READ_YEARS).
# AZURE_BLOB_PUBLIC_READ=false
# AZURE_BLOB_SAS_READ_YEARS=10

# Sin conexión completa: las imágenes se guardan en public/uploads (solo desarrollo).

# -----------------------------------------------------------------------------
# URLs públicas (opcional)
# -----------------------------------------------------------------------------
# Enlaces absolutos (p. ej. compartir recetas) si no hay cabecera Host fiable
# NEXT_PUBLIC_APP_URL=
