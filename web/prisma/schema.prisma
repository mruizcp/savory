generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.NVarChar(320)
  passwordHash String    @db.NVarChar(255)
  displayName  String?   @db.NVarChar(160)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  profile                 UserProfile?
  ingredientInputSessions IngredientInputSession[]
  recipes                 Recipe[]
  favoriteRecipes         RecipeFavorite[]
  cookbooks               Cookbook[]
  historyEvents           HistoryEvent[]
  generationAttempts      RecipeGenerationAttempt[]
  learningAggregate       UserLearningAggregate?
}

/// Snapshot de señales de aprendizaje (recomendaciones), recalculado al consumir el motor.
model UserLearningAggregate {
  userId      String   @id @db.NVarChar(128)
  payloadJson String   @db.NVarChar(4000)
  computedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique @db.NVarChar(128)
  cookingLevel String   @default("BEGINNER") @db.NVarChar(24)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  dietaryRestrictions UserProfileDietaryRestriction[]
  goals               UserProfileGoal[]
  dislikedIngredients UserProfileDislikedIngredient[]
}

model UserProfileDietaryRestriction {
  id        String      @id @default(cuid())
  profileId String
  value     String      @db.NVarChar(120)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, value])
}

model IngredientCatalog {
  id             String   @id @default(cuid())
  nameNormalized String   @unique @db.NVarChar(120)
  displayName    String   @db.NVarChar(120)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  aliases              IngredientAlias[]
  recipeIngredients    RecipeIngredient[]
  ingredientInputItems IngredientInputItem[]
}

model IngredientAlias {
  id              String            @id @default(cuid())
  ingredientId    String
  aliasNormalized String            @db.NVarChar(120)
  ingredient      IngredientCatalog @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, aliasNormalized])
  @@index([aliasNormalized])
}

model IngredientInputSession {
  id                String   @id @default(cuid())
  userId            String   @db.NVarChar(128)
  sourceType        String   @db.NVarChar(24) // MANUAL | PHOTO
  imageUrl          String?  @db.NVarChar(1024)
  storageProvider   String?  @db.NVarChar(80)
  detectionProvider String?  @db.NVarChar(80)
  status            String   @default("COMPLETED") @db.NVarChar(24)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                IngredientInputItem[]
  generationAttempts RecipeGenerationAttempt[]

  @@index([userId, createdAt])
}

model IngredientInputItem {
  id             String   @id @default(cuid())
  sessionId      String
  ingredientId   String?
  rawName        String   @db.NVarChar(120)
  normalizedName String   @db.NVarChar(120)
  origin         String   @db.NVarChar(24) // DETECTED | MANUAL
  wasEdited      Boolean  @default(false)
  confidence     Decimal? @db.Decimal(5, 4)
  createdAt      DateTime @default(now())

  session    IngredientInputSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ingredient IngredientCatalog?     @relation(fields: [ingredientId], references: [id], onDelete: NoAction)

  @@index([sessionId])
  @@index([normalizedName])
}

model Recipe {
  id              String   @id @default(cuid())
  userId          String   @db.NVarChar(128)
  title           String   @db.NVarChar(180)
  description     String?  @db.NVarChar(2000)
  sourceType      String   @db.NVarChar(24) // GENERATED | EXISTING | IMPORTED | CORRECTED
  generationType  String?  @db.NVarChar(24) // WITH_AVAILABLE | WITH_MISSING
  servings        Int?
  totalMinutes    Int?
  calories        Int?
  difficulty      String?  @db.NVarChar(24) // EASY | MEDIUM | HARD
  mealType        String?  @db.NVarChar(40)
  dietTagsCsv     String?  @db.NVarChar(400)
  notes           String?  @db.NVarChar(2000)
  utensilsText    String?  @db.NVarChar(1000)
  aiProvider      String?  @db.NVarChar(80)
  aiModel         String?  @db.NVarChar(120)
  parentRecipeId  String?
  basedOnRecipeId String?
  /// En SQL Server la unicidad solo aplica con valor (índice filtrado en migración).
  shareToken      String?  @db.NVarChar(64)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentRecipe       Recipe?                @relation("RecipeRegeneration", fields: [parentRecipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  regeneratedRecipes Recipe[]             @relation("RecipeRegeneration")
  basedOnRecipe      Recipe?                @relation("RecipeManualCorrection", fields: [basedOnRecipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manualCorrections  Recipe[]               @relation("RecipeManualCorrection")
  steps              RecipeStep[]
  ingredients        RecipeIngredient[]
  favorites          RecipeFavorite[]
  cookbookItems      CookbookRecipe[]
  generationAttempts RecipeGenerationAttempt[]

  @@index([userId, createdAt])
  @@index([title])
  @@index([userId, mealType])
  @@index([userId, difficulty])
}

model RecipeStep {
  id          String   @id @default(cuid())
  recipeId    String
  stepNumber  Int
  instruction String   @db.NVarChar(2000)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
}

model RecipeIngredient {
  id             String   @id @default(cuid())
  recipeId       String
  ingredientId   String?
  ingredientName String   @db.NVarChar(120)
  quantityText   String?  @db.NVarChar(64)
  isMissing      Boolean  @default(false)

  recipe     Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient IngredientCatalog? @relation(fields: [ingredientId], references: [id], onDelete: NoAction)
}

model RecipeGenerationAttempt {
  id                  String   @id @default(cuid())
  userId              String   @db.NVarChar(128)
  recipeId            String?
  ingredientSessionId String?
  promptVersion       String?  @db.NVarChar(64)
  status              String   @db.NVarChar(24) // SUCCESS | ERROR
  errorMessage        String?  @db.NVarChar(2000)
  createdAt           DateTime @default(now())

  user              User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipe            Recipe?                 @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredientSession IngredientInputSession? @relation(fields: [ingredientSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model RecipeFavorite {
  id        String   @id @default(cuid())
  userId    String   @db.NVarChar(128)
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId, createdAt])
}

model Cookbook {
  id          String   @id @default(cuid())
  userId      String   @db.NVarChar(128)
  name        String   @db.NVarChar(120)
  description String?  @db.NVarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes CookbookRecipe[]

  @@index([userId, createdAt])
}

model CookbookRecipe {
  id         String   @id @default(cuid())
  cookbookId String
  recipeId   String
  position   Int?
  addedAt    DateTime @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cookbookId, recipeId])
  @@index([cookbookId, position])
}

model HistoryEvent {
  id           String   @id @default(cuid())
  userId       String   @db.NVarChar(128)
  entityType   String   @db.NVarChar(40) // PROFILE | INGREDIENTS | RECIPE | FAVORITE | COOKBOOK
  entityId     String?  @db.NVarChar(128)
  actionType   String   @db.NVarChar(40) // CREATED | UPDATED | DELETED | REGENERATED | SHARED | FAILED
  summary      String   @db.NVarChar(400)
  metadataText String?  @db.NVarChar(4000)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model UserProfileGoal {
  id        String      @id @default(cuid())
  profileId String
  value     String      @db.NVarChar(80)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, value])
}

model UserProfileDislikedIngredient {
  id        String      @id @default(cuid())
  profileId String
  value     String      @db.NVarChar(120)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, value])
}
